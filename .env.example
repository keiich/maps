# ---- データベース (Neon / Vercel Postgres / Supabase いずれも可) ----
# Vercel の Storage 連携を使うと POSTGRES_URL が自動で入ります。
# 手動で設定する場合は DATABASE_URL にプール接続文字列を入れてください。
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 未設定の場合は .data/reports.json への保存にフォールバックします（ローカル開発用）。
# Vercel の本番環境ではファイルは永続化されないので必ず DB を設定してください。

# ---- 投稿の運用パラメータ (任意) ----
# 同一 IP からの投稿上限（件 / 時間）
RATE_LIMIT_PER_HOUR="5"
# 通報がこの件数に達した投稿は自動的に非表示になります
FLAG_HIDE_THRESHOLD="3"
# IP をハッシュ化する際のソルト（本番では必ずランダムな値に変更してください）
IP_HASH_SALT="change-me"
# 管理操作 (非表示の解除など) 用トークン。未設定なら管理APIは無効。
ADMIN_TOKEN=""
